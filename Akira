local function criarSlider(parent, nome, valorAtual, min, max, callback)
    local frame = criar("Frame", {
        Size = UDim2.new(1, 0, 0, 60),
        BackgroundColor3 = Cores.Card,
        BorderSizePixel = 0,
    }, {
        criar("UICorner", {CornerRadius = UDim.new(0, 10)}),
        criar("UIStroke", {Color = Cores.Roxo, Thickness = 1, Transparency = 0.5}),
    })
    frame.Parent = parent

    local label = criar("TextLabel", {
        Size = UDim2.new(0.6, 0, 0, 20),
        Position = UDim2.new(0, 12, 0, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = Cores.Texto,
        TextXAlignment = Enum.TextXAlignment.Left,
        Text = nome,
    })
    label.Parent = frame

    local valLabel = criar("TextLabel", {
        Size = UDim2.new(0.35, -12, 0, 20),
        Position = UDim2.new(0.6, 0, 0, 8),
        BackgroundTransparency = 1,
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        TextColor3 = Cores.RoxoClaro,
        TextXAlignment = Enum.TextXAlignment.Right,
        Text = tostring(valorAtual),
    })
    valLabel.Parent = frame

    local track = criar("Frame", {
        Size = UDim2.new(1, -24, 0, 10),
        Position = UDim2.new(0, 12, 0, 38),
        BackgroundColor3 = Color3.fromRGB(45, 38, 60),
        BorderSizePixel = 0,
    }, {criar("UICorner", {CornerRadius = UDim.new(1, 0)})})
    track.Parent = frame

    local pct = (valorAtual - min) / (max - min)
    local fill = criar("Frame", {
        Size = UDim2.new(pct, 0, 1, 0),
        BackgroundColor3 = Cores.Roxo,
        BorderSizePixel = 0,
    }, {criar("UICorner", {CornerRadius = UDim.new(1, 0)})})
    fill.Parent = track

    local knob = criar("Frame", {
        Size = UDim2.new(0, 18, 0, 18),
        Position = UDim2.new(pct, -9, 0.5, -9),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BorderSizePixel = 0,
        ZIndex = 2,
    }, {criar("UICorner", {CornerRadius = UDim.new(1, 0)})})
    knob.Parent = track

    local dragging = false

    local function update(input)
        local trackAbs = track.AbsolutePosition.X
        local trackSize = track.AbsoluteSize.X
        if trackSize <= 0 then return end
        local p = math.clamp((input.Position.X - trackAbs) / trackSize, 0, 1)
        local val = math.floor(min + (max - min) * p)
        valLabel.Text = tostring(val)
        fill.Size = UDim2.new(p, 0, 1, 0)
        knob.Position = UDim2.new(p, -9, 0.5, -9)
        if callback then callback(val) end
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            update(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    return frame
end

