local StealState = {
    Carrying = false, Uid = nil, Delivered = 0, Busy = false,
    Cancel = false, Mult = 1, PulledAt = 0, HeldSeen = 0, GuessedDrop = false,
}

if type(EggState) == "table" and type(EggState.CarryChanged) == "table" then
    EggState.CarryChanged:Connect(function(arg)
        local carrying = type(arg) == "table" and arg.IsCarrying == true
        if carrying and arg.GuardDisabled == true then carrying = false end
        StealState.GuessedDrop = false
        if carrying then StealState.HeldSeen = os.clock() end
        if carrying and type(arg.Uid) == "string" then
            StealState.Uid = arg.Uid
            local m = tonumber(arg.SpeedMultiplier)
            if m and m > 0 then StealState.Mult = m end
        end
        StealState.Carrying = carrying
    end)
end

pcall(function()
    remote("RE/EggWorld/FieldEggRedeemVerdict").OnClientEvent:Connect(function()
        StealState.Delivered = os.clock()
    end)
end)

pcall(function()
    remote("RE/RigSync/Refresh").OnClientEvent:Connect(function(arg)
        if type(arg) == "table" and arg.Action == "Relocate" then
            StealState.PulledAt = os.clock()
        end
    end)
end)

local function takeEgg(uid)
    if type(uid) == "string" and type(EggState) == "table" and type(EggState.CarryFieldEgg) == "function" then
        pcall(EggState.CarryFieldEgg, uid)
    end
end

local function dropEgg()
    if type(EggState) == "table" and type(EggState.DropFieldEgg) == "function" then
        pcall(EggState.DropFieldEgg, "PlayerRequest")
    end
end

local function promptNear(pos, radius)
    local best, bd = nil, radius
    for _, ch in ipairs(workspace:GetChildren()) do
        if ch.Name == "SmartPromptPart" and ch:IsA("BasePart") then
            local p = ch:FindFirstChild("CarryAreaEgg")
            if p and p:IsA("ProximityPrompt") then
                local d = (ch.Position - pos).Magnitude
                if d < bd then best, bd = p, d end
            end
        end
    end
    return best
end

local function snapshot()
    local list = {}
    local ok, r = pcall(function()
        return remote("RF/EggWorld/AskFieldEggSnapshot"):InvokeServer()
    end)
    local recs = ok and type(r) == "table" and r.Records or nil
    if type(recs) ~= "table" then return list end
    for _, rec in pairs(recs) do
        if type(rec) == "table" and type(rec.Uid) == "string"
           and (rec.State == "Slot" or rec.State == "Dropped")
           and typeof(rec.BottomCFrame) == "CFrame" then
            list[#list + 1] = rec
        end
    end
    return list
end

local function eggPosition(uid)
    for _, rec in ipairs(snapshot()) do
        if rec.Uid == uid then return rec.BottomCFrame.Position end
    end
    return nil
end

local function describe(rec)
    local dir = type(Assets) == "table" and Assets.Directory or nil
    local entry = type(dir) == "table" and dir[tostring(rec.AssetCategory)] or nil
    local info = { Uid = rec.Uid, Name = tostring(rec.AssetCategory), Icon = "", Value = 0 }

    if type(entry) == "table" then
        info.Name = tostring(entry.DisplayName or rec.AssetCategory)
        local icon = entry.Icon
        if icon ~= nil and tostring(icon) ~= "" then
            icon = tostring(icon)
            info.Icon = tonumber(icon) and ("rbxassetid://" .. icon) or icon
        end
        local scale = tonumber(rec.AssetScale) or 1
        local factor = scale > 5 and (scale / 5) ^ 1.2 * 19.637875755794113 or scale ^ 1.85
        local mut = 1
        if type(Mutations) == "table" and type(Mutations.EarningsFor) == "function" then
            local okM, resM = pcall(Mutations.EarningsFor, type(rec.Mutations) == "table" and rec.Mutations or {})
            if okM and type(resM) == "number" then mut = resM end
        end
        info.Value = (tonumber(entry.EarningRate) or 0) * factor * mut
    end
    return info
end

local function money(v)
    local units = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }
    for _, u in ipairs(units) do
        if v >= u[1] then return string.format("$%.2f%s/s", v / u[1], u[2]) end
    end
    return string.format("$%d/s", math.floor(v + 0.5))
end

local function grab(uid, timeout)
    local waited, since = 0, 1
    while not StealState.Carrying and waited < timeout and not StealState.Cancel do
        local r = root()
        local egg = eggPosition(uid)
        local dt = math.max(RunService.Heartbeat:Wait(), 1/240)
        waited += dt
        since += dt
        if r and egg then
            local delta = egg - r.Position
            if delta.Magnitude > 2 then
                local pace = math.max(walkSpeed() * CFG.SpeedCap, 16)
                local v = delta / math.max(0.08, dt)
                if v.Magnitude > pace then v = v.Unit * pace end
                pcall(function()
                    r.AssemblyLinearVelocity = v + Vector3.new(0, workspace.Gravity * dt * 0.5, 0)
                    r.AssemblyAngularVelocity = Vector3.zero
                end)
            end
            if since >= CFG.GrabInterval then
                since = 0
                local prompt = promptNear(egg - Vector3.new(0, 3, 0), 10)
                if prompt and typeof(fireproximityprompt) == "function" then
                    pcall(function() prompt.HoldDuration = 0 end)
                    pcall(fireproximityprompt, prompt)
                end
                task.spawn(takeEgg, uid)
            end
        elseif since >= CFG.GrabInterval then
            since = 0
            task.spawn(takeEgg, uid)
        end
    end
    local r = root()
    if r then pcall(function() r.AssemblyLinearVelocity = Vector3.zero end) end
    return StealState.Carrying and StealState.Uid == uid
end

local function lineInfo()
    local w = workspace:FindFirstChild("World") or workspace:FindFirstChild("__OBJECTS")
    w = w and w:FindFirstChild("Areas")
    w = w and w:FindFirstChild("SeparationLine")
    local ok = w and w:IsA("BasePart")
    return ok and w.Position.X or 552.2, ok and w.Position.Y or 67.67
end

local function homePoint()
    for _, def in ipairs({
        { { "GearGiver_Slap", "Podium" }, Vector3.new(-16.415, 21.072, -6.106) },
        { { "World", "Machines", "RiftMachine", "Rift", "Meshes/VoidPortal_Cube.003" }, Vector3.new(-26.776, 1.75, 18.665) },
        { { "__OBJECTS", "Machines", "RiftMachine", "Rift", "Meshes/VoidPortal_Cube.003" }, Vector3.new(-26.776, 1.75, 18.665) },
    }) do
        local n = workspace
        for _, name in ipairs(def[1]) do n = n and n:FindFirstChild(name) or nil end
        if n and n:IsA("BasePart") then
            return n.CFrame:PointToWorldSpace(def[2])
        end
    end
    return Vector3.new(528.7, 70.57, -364.11)
end

local function place(pos)
    local r = root()
    if not r then return end
    pcall(function()
        r.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(90), 0)
        r.AssemblyLinearVelocity = Vector3.zero
        r.AssemblyAngularVelocity = Vector3.zero
    end)
end

local function groundY(pos, fallback)
    local y = fallback
    pcall(function()
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        p.FilterDescendantsInstances = { localPlayer.Character }
        p.IgnoreWater = true
        local hit = workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -140, 0), p)
        if hit and hit.Material ~= Enum.Material.Water and math.abs(hit.Position.Y - fallback) < 40 then
            y = hit.Position.Y + 3.5
        end
    end)
    return y
end

local function carrySpeed(distance)
    local ws = walkSpeed()
    local base = ws * math.min(CFG.CarryRatio, CFG.SpeedCap) * StealState.Mult
    local fast = base * 1.5
    local excess = 5.5 * base
    local limit = fast
    if distance and distance > excess then
        limit = math.min(fast, base * distance / (distance - excess))
    end
    return math.min(math.max(math.min(base * CFG.EasyRatio, limit), base), math.max(ws * CFG.SpeedCap, base))
end

local function runHome(lineX, laneZ)
    local started = os.clock()
    local home = homePoint()
    local checkpoint = lineX - 7
    local height = CFG.Height
    local share = math.clamp(CFG.ClimbShare, 0.1, 0.9)
    local descent = height * math.sqrt(1 - share * share) / share
    local c = localPlayer.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    if h then h.PlatformStand = false end

    local r = root()
    if r and c and height > 0.5 and home.Y + height - 2 > r.Position.Y then
        pcall(function()
            c:PivotTo(CFrame.new(Vector3.new(r.Position.X, home.Y + height, r.Position.Z)) * r.CFrame.Rotation)
            r.AssemblyLinearVelocity = Vector3.zero
            r.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    local start = root()
    local speed = carrySpeed(start and (Vector3.new(start.Position.X - home.X, 0, start.Position.Z - home.Z).Magnitude + math.max(0, height) * 2) or nil)

    local last = os.clock()
    local timeout = 0
    while StealState.Carrying and StealState.Delivered < started and not StealState.Cancel and timeout < 25 do
        r = root()
        if not r then return false end
        local now = os.clock()
        local dt = math.max(now - last, 1/240)
        last = now
        timeout += dt

        local toHome = r.Position.X <= checkpoint + 2
        local target = toHome and home or Vector3.new(checkpoint, home.Y, laneZ)
        if toHome and Vector3.new(home.X - r.Position.X, 0, home.Z - r.Position.Z).Magnitude < 2 then break end

        local flat = Vector3.new(target.X - r.Position.X, 0, target.Z - r.Position.Z)
        local remaining = toHome and 0 or math.max(0, r.Position.X - checkpoint)
        local wantY = home.Y + height
        if toHome or remaining <= descent then
            wantY = home.Y + height * math.clamp(remaining / math.max(descent, 1), 0, 1)
        end
        local vy = math.clamp((wantY - r.Position.Y) / 0.12, -speed * share, speed * share)
        local horiz = math.sqrt(math.max(speed * speed - vy * vy, 0))
        local v = flat.Magnitude > 0.01 and flat.Unit * math.min(horiz, flat.Magnitude / 0.05) or Vector3.zero
        pcall(function()
            r.AssemblyLinearVelocity = Vector3.new(v.X, vy, v.Z)
        end)
        RunService.Heartbeat:Wait()
    end

    if h then pcall(function() h:Move(Vector3.zero, false) end) end

    local settle = 0
    while settle < 2 and StealState.Delivered < started and StealState.Carrying and not StealState.Cancel do
        settle += RunService.Heartbeat:Wait()
    end
    if StealState.Carrying and StealState.Delivered < started and not StealState.Cancel then
        task.wait(0.2)
        dropEgg()
        local waited = 0
        while StealState.Delivered < started and waited < 1 do
            waited += RunService.Heartbeat:Wait()
        end
    end
    return StealState.Delivered >= started
end

local function instantTP(uid)
    local started = os.clock()
    local lineX, lineY = lineInfo()
    local r = root()
    if not r then return false end
    local laneZ = math.clamp(r.Position.Z, -425, -300)
    local landing = Vector3.new(lineX + CFG.LandOffset, lineY + 3.35, laneZ)

    local hopStep = math.max(walkSpeed() * CFG.HopRatio, CFG.HopMin)
    local hopY = r.Position.Y + CFG.HopLift
    local x = r.Position.X
    local retries = 0

    while x - hopStep > landing.X and not StealState.Cancel do
        if not StealState.Carrying then
            local egg = eggPosition(uid)
            if not egg then break end
            place(egg + Vector3.new(0, 3, 0))
            grab(uid, 3)
            local cur = root()
            if cur then x = math.min(x, cur.Position.X) end
            continue
        end

        local nextX = x - hopStep
        local pulledBefore = StealState.PulledAt
        local held = 0
        while held < CFG.HopGap do
            place(Vector3.new(nextX, hopY, laneZ))
            held += RunService.Heartbeat:Wait()
        end

        local check = root()
        local pulled = StealState.PulledAt > pulledBefore or (check ~= nil and (check.Position.X - nextX > 10 or check.AssemblyLinearVelocity.Magnitude > 150))
        if pulled and StealState.Carrying and not StealState.Cancel then
            retries += 1
            CFG.HopGap = math.min(CFG.HopGapMax, CFG.HopGap + 0.02)
            if retries > CFG.HopRetries then break end
            local settle = 0
            while settle < 0.12 and not StealState.Cancel do
                place(Vector3.new(x, hopY, laneZ))
                settle += RunService.Heartbeat:Wait()
            end
        else
            x = nextX
            CFG.HopGap = math.max(CFG.HopGapMin, CFG.HopGap - 0.01)
        end
    end

    landing = Vector3.new(landing.X, groundY(landing, landing.Y), landing.Z)
    local function land()
        local cur = root()
        if cur and cur.Position.X <= landing.X + 1 and cur.Position.Y > landing.Y - 25 then
            pcall(function() cur.AssemblyLinearVelocity = Vector3.zero end)
            return
        end
        place(landing)
    end
    land()

    if StealState.Carrying and not StealState.Cancel then
        local d = 0
        while d < CFG.DropDelay do d += RunService.Heartbeat:Wait() end
        dropEgg()
        local w = 0
        while StealState.Carrying and w < 1 and not StealState.Cancel do w += RunService.Heartbeat:Wait() end

        local ok = grab(uid, 3)
        if not ok and not StealState.Cancel then
            local egg = eggPosition(uid)
            if egg then
                place(egg + Vector3.new(0, 3, 0))
                grab(uid, 3)
            end
        end
    end

    local ok2 = false
    if StealState.Carrying then
        ok2 = runHome(lineX, laneZ)
    end
    return ok2 or StealState.Delivered >= started
end

local function stealAndDeliver(uid)
    if StealState.Busy then return end
    StealState.Busy = true
    StealState.Cancel = false
    task.spawn(function()
        local ok, err = pcall(function()
            local egg = eggPosition(uid)
            if not egg then return end

            if State.TPAovoo then
                local r = root()
                if r then
                    pcall(function()
                        r.CFrame = CFrame.new(egg + Vector3.new(0, 3, 0))
                        r.AssemblyLinearVelocity = Vector3.zero
                        r.AssemblyAngularVelocity = Vector3.zero
                    end)
                end
            end

            if StealState.Carrying and StealState.Uid ~= uid then
                dropEgg()
                local w = 0
                while StealState.Carrying and w < 1 do w += RunService.Heartbeat:Wait() end
            end

            local r = root()
            if r and not State.TPAovoo then
                local dx = egg.X - r.Position.X
                local dz = egg.Z - r.Position.Z
                if math.sqrt(dx*dx + dz*dz) > 3 then
                    place(egg + Vector3.new(0, 3, 0))
                end
            end

            if not grab(uid, 4) then return end
            instantTP(uid)
        end)
        StealState.Busy = false
    end)
end

